{
  "name": "WF1 - Reminder Tagihan Harian",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "cron", "h": 8, "m": 0, "timezone": "Asia/Jakarta" }] }
      },
      "id": "wf1-trigger",
      "name": "Cron 08:00 Harian",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1
    },
    {
      "parameters": {
        "url": "={{$env.API_BASE_URL}}/internal/jobs/generate-occurrences",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "x-api-key", "value": "={{$env.N8N_JOBS_API_KEY}}" }] }
      },
      "id": "wf1-generate",
      "name": "Generate Occurrences",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "continueOnFail": true
    },
    {
      "parameters": {
        "url": "={{$env.API_BASE_URL}}/internal/reminders/due",
        "method": "GET",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "x-api-key", "value": "={{$env.N8N_JOBS_API_KEY}}" }] }
      },
      "id": "wf1-fetch-due",
      "name": "Fetch Due Reminders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4
    },
    {
      "parameters": {
        "functionCode": "// Build WhatsApp message per reminder\nconst reminders = $input.all();\nconst messages = reminders.map(r => {\n  const d = r.json;\n  return {\n    to: $env.OWNER_WA_NUMBER,\n    body: `📋 *Pengingat Tagihan*\\n\\n${d.title || 'Tagihan'}\\n${d.message || ''}\\n\\nBalas \"sudah\" jika sudah dibayar.`\n  };\n});\nreturn messages.map(m => ({ json: m }));"
      },
      "id": "wf1-format",
      "name": "Format WA Messages",
      "type": "n8n-nodes-base.function",
      "typeVersion": 2
    },
    {
      "parameters": {
        "url": "={{$env.HERMES_WEBHOOK_URL}}/send",
        "method": "POST",
        "bodyParameters": { "parameters": [{ "name": "message", "value": "={{$json.body}}" }, { "name": "to", "value": "={{$json.to}}" }] }
      },
      "id": "wf1-send-wa",
      "name": "Kirim WA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "continueOnFail": true
    },
    {
      "parameters": {
        "functionCode": "const acks = $input.all().filter(i => i.json.transactionId).map(r => ({\n  json: { id: r.json.id }\n}));\nreturn acks;"
      },
      "id": "wf1-ack",
      "name": "Ack Sent",
      "type": "n8n-nodes-base.function",
      "typeVersion": 2,
      "continueOnFail": true
    }
  ],
  "connections": {
    "Cron 08:00 Harian": { "main": [[{ "node": "Generate Occurrences" }]] },
    "Generate Occurrences": { "main": [[{ "node": "Fetch Due Reminders" }]] },
    "Fetch Due Reminders": { "main": [[{ "node": "Format WA Messages" }]] },
    "Format WA Messages": { "main": [[{ "node": "Kirim WA" }]] },
    "Kirim WA": { "main": [[{ "node": "Ack Sent" }]] }
  },
  "settings": { "executionOrder": "v1" },
  "staticData": null,
  "tags": [{ "name": "kasku" }, { "name": "reminder" }]
}
