{
  "name": "WF3 - Digest Mingguan",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "cron", "weekday": "sunday", "h": 20, "m": 0, "timezone": "Asia/Jakarta" }] }
      },
      "id": "wf3-trigger",
      "name": "Cron Minggu 20:00",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1
    },
    {
      "parameters": {
        "url": "={{$env.API_BASE_URL}}/digest/weekly",
        "method": "GET",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "x-api-key", "value": "={{$env.N8N_DIGEST_API_KEY}}" }] }
      },
      "id": "wf3-fetch",
      "name": "Fetch Weekly Digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4
    },
    {
      "parameters": {
        "functionCode": "const d = $input.first().json;\nconst text = d.text || `📊 *Ringkasan Mingguan*\\n\\nPemasukan: Rp${(d.income||0).toLocaleString('id-ID')}\\nPengeluaran: Rp${(d.expense||0).toLocaleString('id-ID')}\\nSisa: Rp${(d.net||0).toLocaleString('id-ID')}\\n\\n${d.transactionCount||0} transaksi.`;\nreturn [{ json: {\n  to: $env.OWNER_WA_NUMBER,\n  body: text\n} }];"
      },
      "id": "wf3-format",
      "name": "Format Message",
      "type": "n8n-nodes-base.function",
      "typeVersion": 2
    },
    {
      "parameters": {
        "url": "={{$env.HERMES_WEBHOOK_URL}}/send",
        "method": "POST",
        "bodyParameters": { "parameters": [{ "name": "message", "value": "={{$json.body}}" }, { "name": "to", "value": "={{$json.to}}" }] }
      },
      "id": "wf3-send-wa",
      "name": "Kirim WA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "continueOnFail": true
    }
  ],
  "connections": {
    "Cron Minggu 19:00": { "main": [[{ "node": "Fetch Weekly Digest" }]] },
    "Fetch Weekly Digest": { "main": [[{ "node": "Format Message" }]] },
    "Format Message": { "main": [[{ "node": "Kirim WA" }]] }
  },
  "settings": { "executionOrder": "v1" },
  "staticData": null,
  "tags": [{ "name": "kasku" }, { "name": "digest" }]
}
